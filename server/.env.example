# --- Database / auth -------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ember_bun
JWT_SECRET=change-me
PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Order emails (Gmail) --------------------------------------------------
# The address the confirmation / status / cancellation emails are sent from.
GMAIL_USER=you@gmail.com

# Option A - app password (Google account > Security > 2-Step Verification >
# App passwords). Simplest for a single restaurant account.
GMAIL_APP_PASSWORD=

# Option B - Google API OAuth2 (Google Cloud console > OAuth client, Gmail API
# enabled, refresh token from the OAuth playground). Takes precedence over
# the app password when GMAIL_REFRESH_TOKEN is set.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional display name/address for the From header.
MAIL_FROM="Ember & Bun <you@gmail.com>"
